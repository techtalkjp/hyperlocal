{
  "name": "hyperlocal",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "format": "turbo format",
    "format:fix": "turbo format:fix",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "validate": "turbo validate",
    "db:apply": "pnpm --filter @hyperlocal/db db:apply",
    "db:apply:production": "pnpm --filter @hyperlocal/db db:apply:production",
    "db:generate": "pnpm --filter @hyperlocal/db db:generate",
    "db:diff": "pnpm --filter @hyperlocal/db db:diff",
    "db:replica": "pnpm --filter @hyperlocal/web make:replica",
    "db:reset": "pnpm --filter @hyperlocal/web db:reset",
    "doctor": "npx react-doctor@latest"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "react-doctor": "catalog:",
    "turbo": "catalog:"
  },
  "packageManager": "pnpm@12.4.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    }
  }
}
