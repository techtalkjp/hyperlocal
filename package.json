{
  "name": "hyperlocal",
  "scripts": {
    "build": "vp run -r --concurrency-limit 2 build",
    "dev": "vp run --parallel -r dev",
    "format": "vp run -r format",
    "format:fix": "vp run -r format:fix",
    "lint": "vp run -r lint",
    "typecheck": "vp run -r --concurrency-limit 2 typecheck",
    "test": "vp run -r --concurrency-limit 2 test",
    "validate": "vp run -r --concurrency-limit 2 validate",
    "db:apply": "pnpm --filter @hyperlocal/db db:apply",
    "db:apply:production": "pnpm --filter @hyperlocal/db db:apply:production",
    "db:generate": "pnpm --filter @hyperlocal/db db:generate",
    "db:diff": "pnpm --filter @hyperlocal/db db:diff",
    "db:replica": "pnpm --filter @hyperlocal/web make:replica",
    "db:reset": "pnpm --filter @hyperlocal/web db:reset",
    "doctor": "npx react-doctor@latest"
  },
  "devDependencies": {
    "react-doctor": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.4.1"
}
