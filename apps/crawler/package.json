{
  "name": "@hyperlocal/crawler",
  "version": "0.0.1",
  "license": "ISC",
  "author": "It's not you it's me",
  "type": "module",
  "scripts": {
    "crawl": "tsx --env-file=.env src/index.ts",
    "build": "tsc",
    "start:crawler": "npm run start:crawler:dev",
    "start:crawler:prod": "node dist/index.js",
    "start:crawler:dev": "tsx src/index.ts",
    "format": "vp fmt --check .",
    "format:fix": "vp fmt --write .",
    "lint": "vp lint .",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@ai-sdk/google": "catalog:",
    "@date-fns/tz": "catalog:",
    "@date-fns/utc": "catalog:",
    "@duckdb/node-api": "catalog:",
    "@hyperlocal/consts": "workspace:*",
    "@hyperlocal/db": "workspace:*",
    "@hyperlocal/google-place-api": "workspace:*",
    "ai": "catalog:",
    "citty": "0.2.2",
    "consola": "3.4.2",
    "crawlee": "catalog:",
    "date-fns": "catalog:",
    "dotenv": "catalog:",
    "kysely": "catalog:",
    "kysely-duckdb": "catalog:",
    "tsx": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
