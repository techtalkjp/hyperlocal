{
  "name": "@hyperlocal/admin",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "react-router dev",
    "build": "vp build",
    "deploy": "vp build && wrangler deploy --config build/server/wrangler.json",
    "generate:article": "tsx --env-file .env scripts/generate-article.ts",
    "import:articles": "tsx --env-file .env scripts/import-articles.ts",
    "translate:articles": "tsx --env-file .env scripts/translate-articles.ts",
    "lint": "vp lint .",
    "format": "vp fmt --check .",
    "format:fix": "vp fmt --write .",
    "typecheck": "react-router typegen && tsc",
    "test": "vp test run",
    "validate": "run-s format lint typecheck test"
  },
  "dependencies": {
    "@ai-sdk/google": "catalog:",
