  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "lint": "vp lint .",
    "format": "vp fmt --check .",
    "format:fix": "vp fmt --write .",
    "typecheck": "tsc --noEmit",
    "validate": "run-s lint format typecheck",
    "db:generate": "kysely-codegen",
    "db:diff": "atlas schema apply --env local --dry-run",
    "db:apply": "atlas schema apply --env local --auto-approve",
    "db:apply:production": "dotenv -e .env -- atlas schema apply --env production"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260914.1",
    "@hyperlocal/google-place-api": "workspace:*",
    "@libsql/client": "catalog:",
    "@libsql/kysely-libsql": "catalog:",
    "dotenv": "catalog:",
    "kysely": "catalog:",
    "kysely-d1": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "dotenv-cli": "catalog:",
    "kysely-codegen": "catalog:",
    "npm-run-all": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
